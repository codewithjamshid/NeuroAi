# NeuroAI — muhit o'zgaruvchilari (TZ Ilova D). Nusxa: `cp .env.example .env`
# Root `.env` bitta manba: Makefile, docker-compose, apps/api (pydantic-settings) va apps/web shu fayldan o'qiydi.

# --- Umumiy ---
APP_ENV=dev
DEMO_MODE=true
JWT_SECRET=change-me
# docker compose ichida api uchun compose o'zi `@postgres:5432` beradi (docker-compose.yml → environment).
# `make dev` (api host'da, postgres docker'da, host port POSTGRES_PORT=5433):
DATABASE_URL=postgresql+asyncpg://neuroai:neuroai@localhost:5433/neuroai
# Docker'siz solo dev fallback:
# DATABASE_URL=sqlite+aiosqlite:///./dev.db
MEDIA_DIR=./media
AUDIO_RETENTION_HOURS=24
DEFAULT_LOCALE=uz-Latn
EMERGENCY_NUMBER=103
UNIFIED_EMERGENCY=112
MENTAL_HEALTH_HOTLINE=

# --- AI worker (ofis GPU, ngrok) ---
# worker tayyor bo'lguncha: mock
AI_WORKER_URL=mock
# AI_WORKER_URL=https://<static-domain>.ngrok-free.app
AI_WORKER_KEY=change-me-long-random
AI_WORKER_TIMEOUT_S=4

# --- Bulut provayderlar ---
GEMINI_API_KEY=
# mavjud bo'lsa eng yangi Flash'ga almashtiring
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# --- Provayder zanjirlari (tartib = ustuvorlik) ---
LLM_PROVIDERS=gemini,openai
STT_PROVIDERS=worker,gemini,openai
TTS_PROVIDERS=worker,gemini,openai,browser
VOICE_EMOTION_PROVIDERS=worker
LLM_TEMPERATURE=0.4
TTS_SPEED=0.85

# --- Xabarnomalar ---
TELEGRAM_BOT_TOKEN=
DAILY_SUMMARY_TIME=20:00
TZ=Asia/Samarkand

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_FACE_FPS=15
# bemor ekranidagi "Yordam" tugmasi (tel:) — parvarishchi raqami ulanguncha (T-15)
NEXT_PUBLIC_EMERGENCY_NUMBER=103

# --- Dev / infra (T-01, ADR-005) ---
# Portlar band bo'lsa shu yerda o'zgartiring (NEXT_PUBLIC_API_URL ni ham moslang).
API_PORT=8000
WEB_PORT=3000
WORKER_PORT=8001
# docker postgres host'da shu portda chiqadi (lokal Postgres bilan to'qnashmasin deb 5432 emas)
POSTGRES_PORT=5433
POSTGRES_USER=neuroai
POSTGRES_PASSWORD=neuroai
POSTGRES_DB=neuroai
# Bo'sh qolsa WEB_PORT dan olinadi (http://localhost:$WEB_PORT,http://127.0.0.1:$WEB_PORT); tunnel bo'lsa to'ldiring
CORS_ORIGINS=
LOG_LEVEL=INFO

# --- ai_worker (apps/ai_worker/.env) ---
# Laptopda MODELS_ENABLED bo'sh qoladi (skelet, /health → hammasi "disabled").
# Ofis GPU kompyuterida apps/ai_worker/.env: MODELS_ENABLED=stt,tts,voice_emotion (,medllm — P2)
WORKER_KEY=change-me-long-random
MODELS_ENABLED=
STT_MODEL_PATH=./models/kotib-ct2
STT_COMPUTE_TYPE=float16
TTS_MODEL_PATH=./models/navoiy-tts
EMOTION_MODEL=emotion2vec/emotion2vec_plus_base
AVD_MODEL=audeering/wav2vec2-large-robust-12-ft-emotion-msp-dim
MEDLLM_MODEL=google/medgemma-1.5-4b-it
