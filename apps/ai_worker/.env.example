# apps/ai_worker/.env — ofis GPU kompyuteri uchun (TZ Ilova D, "ai_worker" bo'limi).
# Laptopda kerak emas: root .env dagi WORKER_KEY / MODELS_ENABLED= (bo'sh) o'qiladi.
# Ustuvorlik: muhit o'zgaruvchisi > apps/ai_worker/.env > <repo>/.env
WORKER_KEY=change-me-long-random
WORKER_PORT=8001
# ,medllm (P2)
MODELS_ENABLED=stt,tts,voice_emotion
STT_MODEL_PATH=./models/kotib-ct2
STT_COMPUTE_TYPE=float16
TTS_MODEL_PATH=./models/navoiy-tts
EMOTION_MODEL=emotion2vec/emotion2vec_plus_base
AVD_MODEL=audeering/wav2vec2-large-robust-12-ft-emotion-msp-dim
MEDLLM_MODEL=google/medgemma-1.5-4b-it
LOG_LEVEL=INFO
